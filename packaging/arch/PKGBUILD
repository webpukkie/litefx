# Maintainer: wwwebkar <https://github.com/wwwebkar/litefx>
pkgname=litefx
pkgver=0.3.0
pkgrel=1
pkgdesc="A lightweight alternative to EasyEffects and other audio processing nerd stuff (~2.5 MB daemon RAM)"
arch=('x86_64' 'aarch64')
url="https://github.com/wwwebkar/litefx"
license=('MIT')
depends=('pipewire' 'gtk3' 'zita-convolver' 'gcc-libs' 'glibc')
makedepends=('gcc' 'pkgconf' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  make PREFIX=/usr
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  make test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make PREFIX=/usr DESTDIR="$pkgdir" install
}
